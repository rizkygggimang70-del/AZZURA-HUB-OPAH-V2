-- MODUL 4: MISC (SPEED + DOUBLE JUMP)
-- =====================================================
safe("MISC", function()
    local SMIN, SMAX, SSTEP = 16, 100, 8
    local speedOn, speedVal, origSpeed = false, 32, 16
    local djOn, floatOn = false, false
    local extra, lastGround, lastDouble = 1, os.clock(), 0
    local boundHum, speedConn = nil, nil

    local function getHum()
        local c = player.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then return h end
        return nil
    end

    local function getRoot(hum)
        return hum.RootPart or (hum.Parent and hum.Parent:FindFirstChild("HumanoidRootPart"))
    end

    -- UI
    local speedBtn = mkBtn(pageMisc, "SPEED : OFF", UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 30))
    local sMinus = mkBtn(pageMisc, "-", UDim2.fromOffset(0, 34), UDim2.fromOffset(60, 30))
    local sLabel = mkLabel(pageMisc, "", UDim2.fromOffset(64, 34), UDim2.new(1, -134, 0, 30), 13, GOLD, Enum.TextXAlignment.Center)
    local sPlus = mkBtn(pageMisc, "+", UDim2.new(1, -66, 0, 34), UDim2.fromOffset(60, 30))
    local djBtn = mkBtn(pageMisc, "DOUBLE JUMP : OFF", UDim2.fromOffset(0, 68), UDim2.new(1, -6, 0, 30))
    local floatBtn = mkBtn(pageMisc, "TOMBOL 2x JUMP : OFF", UDim2.fromOffset(0, 102), UDim2.new(1, -6, 0, 30))

    -- Tombol melayang 2x JUMP (opsional, default tersembunyi)
    local djFloat = Instance.new("TextButton")
    djFloat.Name = "DJFloat"
    djFloat.Size = UDim2.fromOffset(64, 64)
    djFloat.Position = UDim2.new(1, -150, 1, -150)
    djFloat.BackgroundColor3 = C_ON
    djFloat.BackgroundTransparency = 0.2
    djFloat.TextColor3 = Color3.new(1, 1, 1)
    djFloat.Font = Enum.Font.GothamBold
    djFloat.TextSize = 13
    djFloat.Text = "2x\nJUMP"
    djFloat.Active = true
    djFloat.Draggable = true
    djFloat.Visible = false
    djFloat.Parent = gui
    corner(djFloat, 32)

    local function updFloat()
        djFloat.Visible = djOn and floatOn
    end

    local function updSpeedLabel()
        sLabel.Text = "SPEED: " .. speedVal
    end
    updSpeedLabel()

    -- ===== SPEED =====
    local function applySpeed(hum)
        if speedOn and hum.WalkSpeed ~= speedVal then
            hum.WalkSpeed = speedVal
        end
    end

    -- Pantau perubahan WalkSpeed: kalau game reset speed, langsung timpa lagi
    local function bind(hum)
        if boundHum == hum then return end
        if speedConn then speedConn:Disconnect() end
        boundHum = hum
        speedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            local ws = hum.WalkSpeed
            if speedOn then
                if ws ~= speedVal then
                    origSpeed = ws
                    hum.WalkSpeed = speedVal
                end
            else
                origSpeed = ws
            end
        end)
    end

    speedBtn.Activated:Connect(function()
        speedOn = not speedOn
        local hum = getHum()
        if hum then
            if speedOn then
                origSpeed = hum.WalkSpeed
                hum.WalkSpeed = speedVal
            else
                hum.WalkSpeed = origSpeed
            end
        end
        speedBtn.Text = "SPEED : " .. (speedOn and "ON" or "OFF")
        speedBtn.BackgroundColor3 = speedOn and C_ON or C_BTN
    end)

    sMinus.Activated:Connect(function()
        speedVal = math.max(SMIN, speedVal - SSTEP)
        updSpeedLabel()
    end)
    sPlus.Activated:Connect(function()
        speedVal = math.min(SMAX, speedVal + SSTEP)
        updSpeedLabel()
    end)

    -- ===== DOUBLE JUMP =====
    local ST = Enum.HumanoidStateType

    local function tryDouble()
        if not djOn then return end
        local hum = getHum()
        if not hum then return end

        local st = hum:GetState()
        local inAir = hum.FloorMaterial == Enum.Material.Air or st == ST.Freefall or st == ST.Jumping
        if not inAir or extra <= 0 then return end

        local t = os.clock()
        if t - lastGround < 0.15 or t - lastDouble < 0.25 then return end

        local hrp = getRoot(hum)
        if not hrp then return end

        extra = extra - 1
        lastDouble = t

        local power = hum.UseJumpPower and hum.JumpPower or math.sqrt(2 * Workspace.Gravity * hum.JumpHeight)
        if power < 40 then power = 50 end -- kalau game matiin lompat (power 0), pakai nilai default

        pcall(function() hum:SetStateEnabled(ST.Jumping, true) end)
        local v = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
        pcall(function() hum:ChangeState(ST.Jumping) end)
    end

    djBtn.Activated:Connect(function()
        djOn = not djOn
        djBtn.Text = "DOUBLE JUMP : " .. (djOn and "ON" or "OFF")
        djBtn.BackgroundColor3 = djOn and C_ON or C_BTN
        updFloat()
    end)

    floatBtn.Activated:Connect(function()
        floatOn = not floatOn
        floatBtn.Text = "TOMBOL 2x JUMP : " .. (floatOn and "ON" or "OFF")
        floatBtn.BackgroundColor3 = floatOn and C_ON or C_BTN
        updFloat()
    end)

    djFloat.MouseButton1Down:Connect(tryDouble)
    track(UIS.JumpRequest:Connect(tryDouble))
    track(UIS.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space then tryDouble() end
    end))

    -- ===== LOOP UTAMA =====
    local function enforce()
        local hum = getHum()
        if not hum then return end
        bind(hum)
        applySpeed(hum)
    end

    track(RunService.Stepped:Connect(enforce))
    track(RunService.RenderStepped:Connect(enforce))
    track(RunService.Heartbeat:Connect(function()
        local hum = getHum()
        if not hum then return end
        bind(hum)
        applySpeed(hum)

        -- reset jatah double jump saat napak tanah
        local st = hum:GetState()
        if hum.FloorMaterial ~= Enum.Material.Air
            or st == ST.Running or st == ST.Landed or st == ST.RunningNoPhysics then
            extra = 1
            lastGround = os.clock()
        end
    end))

    table.insert(cleanups, function()
        if speedConn then speedConn:Disconnect() end
        if speedOn then
            local hum = getHum()
            if hum then hum.WalkSpeed = origSpeed end
        end
        speedOn, djOn, floatOn = false, false, false
    end)
end)

