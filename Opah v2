-- MODUL 1: ESP (KUNCI, OPAH, PLAYER) + ATUR JARAK
-- =====================================================
safe("ESP", function()
    local espRange = 300
    local RANGE_MIN, RANGE_MAX, RANGE_STEP = 50, 1000, 50

    local function makeFeature(scanFn, ignoreRange)
        local f = {on = false, items = {}, tagged = {}, session = 0, onCount = nil}

        function f.count()
            local n = 0
            for _ in pairs(f.tagged) do n = n + 1 end
            return n
        end

        function f.isInside(obj)
            local p = obj.Parent
            while p do
                if f.tagged[p] then return true end
                p = p.Parent
            end
            return false
        end

        function f.tag(obj, part, text, color, size)
            if f.tagged[obj] then return end

            local hl = Instance.new("Highlight")
            hl.Name = "AzzuraTag"
            hl.Adornee = obj
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = 0.4
            hl.Parent = obj
            table.insert(f.items, hl)

            local bgui = Instance.new("BillboardGui")
            bgui.Name = "AzzuraTag"
            bgui.Size = UDim2.new(0, 170, 0, 30)
            bgui.StudsOffset = Vector3.new(0, 2.5, 0)
            bgui.AlwaysOnTop = true
            bgui.Adornee = part
            bgui.Parent = part
            table.insert(f.items, bgui)

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Text = text
            txt.TextColor3 = color
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = size or 13
            txt.Parent = bgui

            f.tagged[obj] = {part = part, hl = hl, bgui = bgui, txt = txt, base = text}
        end

        function f.refresh()
            local hrp = getHrp()
            for obj, e in pairs(f.tagged) do
                if obj.Parent and e.part and e.part.Parent and hrp then
                    local dist = (e.part.Position - hrp.Position).Magnitude
                    local visible = ignoreRange or dist <= espRange
                    e.bgui.Enabled = visible
                    e.hl.Enabled = visible
                    e.txt.Text = e.base .. " [" .. math.floor(dist) .. "m]"
                end
            end
        end

        function f.clear()
            for _, i in ipairs(f.items) do
                pcall(function() i:Destroy() end)
            end
            f.items = {}
            f.tagged = {}
        end

        function f.set(state)
            f.on = state
            f.session = f.session + 1
            if state then
                local mySession = f.session
                task.spawn(function()
                    local lastScan = 0
                    while f.on and f.session == mySession and gui.Parent do
                        if os.clock() - lastScan >= 2 then
                            lastScan = os.clock()
                            for obj in pairs(f.tagged) do
                                if not obj.Parent then f.tagged[obj] = nil end
                            end
                            local ok, err = pcall(scanFn, f)
                            if not ok then warn("AZZURA ERROR: " .. tostring(err)) end
                            if f.onCount then pcall(f.onCount, f.count()) end
                        end
                        pcall(f.refresh)
                        task.wait(0.25)
                    end
                end)
            else
                f.clear()
            end
        end

        table.insert(allFeatures, f)
        return f
    end

    -- ESP KUNCI
    local KEY_COLORS = {
        {{"yellow", "kuning"}, "KUNCI KUNING", Color3.fromRGB(255, 255, 0)},
        {{"red", "merah"},     "KUNCI MERAH",  Color3.fromRGB(255, 0, 0)},
        {{"green", "hijau"},   "KUNCI HIJAU",  Color3.fromRGB(0, 255, 0)},
        {{"purple", "ungu"},   "KUNCI UNGU",   Color3.fromRGB(180, 0, 255)},
        {{"blue", "biru"},     "KUNCI BIRU",   Color3.fromRGB(0, 150, 255)},
    }

    local function colorDistance(a, b)
        return (a.R - b.R) ^ 2 + (a.G - b.G) ^ 2 + (a.B - b.B) ^ 2
    end

    local function getPartColor(obj)
        if obj:IsA("BasePart") then return obj.Color end
        local bestColor, bestSat = nil, -1
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BasePart") then
                local _, s = d.Color:ToHSV()
                if s > bestSat then
                    bestSat = s
                    bestColor = d.Color
                end
            end
        end
        return bestColor
    end

    local function getKeyInfo(nameLower, obj)
        for _, entry in ipairs(KEY_COLORS) do
            for _, word in ipairs(entry[1]) do
                if nameLower:find(word, 1, true) then
                    return entry[2], entry[3]
                end
            end
        end
        local c = getPartColor(obj)
        if c then
            local best, bestDist = KEY_COLORS[1], math.huge
            for _, entry in ipairs(KEY_COLORS) do
                local d = colorDistance(c, entry[3])
                if d < bestDist then
                    bestDist = d
                    best = entry
                end
            end
            return best[2], best[3]
        end
        return "KUNCI", Color3.fromRGB(255, 255, 255)
    end

    local keyFeature = makeFeature(function(f)
        for _, k in ipairs(topKeys()) do
            if not f.tagged[k.obj] and not f.isInside(k.obj) then
                local label, color = getKeyInfo(k.obj.Name:lower(), k.obj)
                f.tag(k.obj, k.part, label, color, 13)
            end
        end
    end)

    -- ESP OPAH (1 saja, terdekat, selalu tampil)
    local opahFeature = makeFeature(function(f)
        local best, bestPart = findOpah()
        if not best then
            f.clear()
            f.current = nil
        elseif f.current ~= best or not f.tagged[best] then
            f.clear()
            f.current = best
            f.tag(best, bestPart, "OPAH", Color3.fromRGB(255, 0, 0), 14)
        end
    end, true)

    -- ESP PLAYER
    local playerFeature = makeFeature(function(f)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and not f.tagged[p.Character] then
                    f.tag(p.Character, hrp, p.Name, Color3.fromRGB(0, 255, 255), 12)
                end
            end
        end
    end)

    -- Tombol ESP
    local list = {
        {"ESP KUNCI", keyFeature},
        {"ESP OPAH", opahFeature},
        {"ESP PLAYER", playerFeature},
    }

    for i, data in ipairs(list) do
        local name, feature = data[1], data[2]
        local b = mkBtn(pageESP, name .. " : OFF", UDim2.fromOffset(0, (i - 1) * 34), UDim2.new(1, -6, 0, 30))
        local enabled = false

        feature.onCount = function(n)
            if enabled then
                b.Text = name .. " : ON (" .. n .. ")"
            end
        end

        b.Activated:Connect(function()
            enabled = not enabled
            b.Text = name .. (enabled and " : ON (0)" or " : OFF")
            b.BackgroundColor3 = enabled and C_ON or C_BTN
            local ok, err = pcall(feature.set, enabled)
            if not ok then warn("AZZURA ERROR: " .. tostring(err)) end
        end)
