local function hasOpahAncestor(obj)
    local p = obj.Parent
    while p and p ~= Workspace do
        if p:IsA("Model") and p.Name:lower():find("opah", 1, true) then
            return true
        end
        p = p.Parent
    end
    return false
end

local EXIT_WORDS = {"exit", "keluar", "escape", "kabur", "gerbang", "finish", "gate"}

local function hasExitWord(s)
    s = tostring(s):lower()
    for _, w in ipairs(EXIT_WORDS) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

local function isKeyName(n)
    return (n:find("key", 1, true) or n:find("kunci", 1, true))
        and not n:find("monkey", 1, true)
        and not n:find("keypad", 1, true)
        and not n:find("keyboard", 1, true)
        and not n:find("keyhole", 1, true)
end

local function getHrp()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function mine(obj)
    local c = player.Character
    if c and obj:IsDescendantOf(c) then return true end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp and obj:IsDescendantOf(bp) then return true end
    return false
end

local function partOf(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
end

-- part tempat prompt / click detector menempel
local function anchorPart(inst)
    local p = inst.Parent
    if not p then return nil end
    if p:IsA("Attachment") then p = p.Parent end
    if p and p:IsA("Model") then p = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
    if p and p:IsA("BasePart") then return p end
    return nil
end

-- Index: daftar objek penting disimpan sekali, diupdate lewat event (bukan scan terus-menerus)
local Index = {
    ready = false,
    keys = {}, opah = {}, prompts = {}, clicks = {}, passText = {}, exits = {},
}
local indexSets = {Index.keys, Index.opah, Index.prompts, Index.clicks, Index.passText, Index.exits}

local function classify(d)
    if d:IsA("ProximityPrompt") then
        Index.prompts[d] = true
    elseif d:IsA("ClickDetector") then
        Index.clicks[d] = true
    elseif d:IsA("TextLabel") or d:IsA("TextBox") then
        Index.passText[d] = true
    elseif d:IsA("StringValue") or d:IsA("IntValue") or d:IsA("NumberValue") then
        local n = d.Name:lower()
        if n:find("pass", 1, true) or n:find("code", 1, true) or n:find("sandi", 1, true) then
            Index.passText[d] = true
        end
    end

    if d:IsA("Model") or d:IsA("BasePart") or d:IsA("Tool") then
        local n = d.Name:lower()
        if isKeyName(n) then Index.keys[d] = true end
        if d:IsA("Model") and n:find("opah", 1, true)
            and not n:find("motor", 1, true) and not n:find("vehicle", 1, true) then
            Index.opah[d] = true
        end
        if (d:IsA("BasePart") or d:IsA("Model")) and hasExitWord(n) then
            Index.exits[d] = true
        end
    end
end

local function unindex(d)
    for _, s in ipairs(indexSets) do s[d] = nil end
end

task.spawn(function()
    local list = Workspace:GetDescendants()
    for i, d in ipairs(list) do
