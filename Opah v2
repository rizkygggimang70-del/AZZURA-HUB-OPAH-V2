-- Kunci paling luar (bukan bagian dari kunci lain), yang belum kita bawa
local function topKeys()
    local result = {}
    for obj in pairs(Index.keys) do
        if obj.Parent and obj:IsDescendantOf(Workspace) and not mine(obj) then
            local nested = false
            local p = obj.Parent
            while p and p ~= Workspace do
                if Index.keys[p] then
                    nested = true
                    break
                end
                p = p.Parent
            end
            if not nested then
                local part = partOf(obj)
                if part then table.insert(result, {obj = obj, part = part}) end
            end
        end
    end
    return result
end

-- Opah terdekat: obj, part, jarak (math.huge kalau tidak ada)
local function findOpah()
    local hrp = getHrp()
    local best, bestPart, bestDist = nil, nil, math.huge
    for obj in pairs(Index.opah) do
        if obj.Parent and not hasOpahAncestor(obj) then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local dist = hrp and (part.Position - hrp.Position).Magnitude or math.huge
                if dist < bestDist then
                    best, bestPart, bestDist = obj, part, dist
                end
            end
        end
    end
    return best, bestPart, bestDist
end

-- Pintu keluar: prompt bertuliskan keluar dulu, lalu part/model bernama keluar (yang terdekat)
local function findExit()
    local hrp = getHrp()
    local bestObj, bestPart, bestDist = nil, nil, math.huge

    for pp in pairs(Index.prompts) do
        if pp.Parent and (hasExitWord(pp.ActionText) or hasExitWord(pp.ObjectText) or hasExitWord(pp.Name)) then
            local part = anchorPart(pp)
            if part then
                local dist = hrp and (part.Position - hrp.Position).Magnitude or 0
                if dist < bestDist then bestObj, bestPart, bestDist = pp, part, dist end
            end
        end
    end
    if bestObj then return bestObj, bestPart end

    for d in pairs(Index.exits) do
        if d.Parent then
            local part = partOf(d)
            if part then
                local dist = hrp and (part.Position - hrp.Position).Magnitude or 0
                if dist < bestDist then bestObj, bestPart, bestDist = d, part, dist end
            end
        end
    end
    return bestObj, bestPart
end

-- Semua prompt / click detector di sekitar karakter
local function nearby(radius)
    local hrp = getHrp()
    local res = {prompts = {}, clicks = {}}
    if not hrp then return res end
    for d in pairs(Index.prompts) do
        if d.Parent then
            local part = anchorPart(d)
            if part then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist <= radius then table.insert(res.prompts, {inst = d, dist = dist, part = part}) end
            end
        end
    end
    for d in pairs(Index.clicks) do
        if d.Parent then
            local part = anchorPart(d)
            if part then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist <= radius then table.insert(res.clicks, {inst = d, dist = dist, part = part}) end
            end
        end
    end
    return res
end

local PASS_WORDS = {"pass", "code", "note", "sandi", "kertas", "paper", "memo"}

local function nameHasPassWord(inst)
    local p = inst
    while p and p ~= Workspace do
        local n = p.Name:lower()
        for _, w in ipairs(PASS_WORDS) do
            if n:find(w, 1, true) then return true end
        end
        p = p.Parent
    end
    return false
end

local function findPasscode()
    local fallback = nil
    for d in pairs(Index.passText) do
        if d.Parent then
            if d:IsA("TextLabel") or d:IsA("TextBox") then
                local t = (d.Text:gsub("%s", ""))
                if t:match("^%d+$") and #t >= 3 and #t <= 6 then
                    if nameHasPassWord(d) then
                        return t
                    end
                    if not fallback and d:FindFirstAncestorWhichIsA("SurfaceGui") then
                        fallback = t
                    end
                end
            else
                local t = tostring(d.Value)
                if t:match("^%d+$") and #t >= 3 and #t <= 6 then
                    return t
                end
            end
        end
    end
    return fallback
end

