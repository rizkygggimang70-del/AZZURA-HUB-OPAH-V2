    local guardOn = true
    local STEP_DELAY = 0.5
    local KEY_RADIUS, DOOR_RADIUS = 12, 15
    local SAFE_DIST, PANIC_DIST, GUARD_TIMEOUT = 35, 20, 30
    local safePos = nil

    -- UI
    local autoBtn = mkBtn(pageAuto, "AUTO KUNCI + KABUR : OFF", UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 30))
    local status = mkLabel(pageAuto, "Status: siap", UDim2.fromOffset(0, 34), UDim2.new(1, -6, 0, 30), 11, GOLD)
    status.TextWrapped = true
    status.TextYAlignment = Enum.TextYAlignment.Top
    local keysBtn = mkBtn(pageAuto, "AMBIL SEMUA KUNCI SAJA", UDim2.fromOffset(0, 68), UDim2.new(1, -6, 0, 30))
    local exitBtn = mkBtn(pageAuto, "TELEPORT + BUKA PINTU KELUAR", UDim2.fromOffset(0, 102), UDim2.new(1, -6, 0, 30))
    local guardBtn = mkBtn(pageAuto, "PENGAMAN OPAH : ON", UDim2.fromOffset(0, 136), UDim2.new(1, -6, 0, 30))
    guardBtn.BackgroundColor3 = C_ON
    local infoBtn = mkBtn(pageAuto, "COPY INFO SEKITAR (DEBUG)", UDim2.fromOffset(0, 170), UDim2.new(1, -6, 0, 30))
    local note = mkLabel(pageAuto,
        "Pengaman Opah: auto berhenti kalau Opah dekat (<35 studs) dan kabur ke titik awal kalau <20 studs. Kalau pintu butuh passcode, isi manual pakai PASSCODE di atas.",
        UDim2.fromOffset(0, 204), UDim2.new(1, -6, 0, 60), 10, GRAY)
    note.TextWrapped = true
    note.TextYAlignment = Enum.TextYAlignment.Top

    local function setStatus(t) status.Text = "Status: " .. t end

    local function getHum()
        local c = player.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function tp(pos, up)
        local hrp = getHrp()
        if not hrp then return false end
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, up or 3, 0))
        return true
    end

    -- ===== pengaman Opah =====
    local function guard(my)
        if not guardOn then return end
        local t0 = os.clock()
        while session == my and gui.Parent do
            local _, _, d = findOpah()
            if d >= SAFE_DIST then return end
            if os.clock() - t0 > GUARD_TIMEOUT then
                setStatus("Opah masih dekat, lanjut aja")
                return
            end
            if d < PANIC_DIST and safePos then
                setStatus("Opah dekat (" .. math.floor(d) .. "m), kabur ke titik aman")
                tp(safePos, 3)
            else
                setStatus("tunggu, Opah dekat (" .. math.floor(d) .. "m)")
            end
            task.wait(0.5)
        end
    end

    local function markSafe()
        local hrp = getHrp()
        safePos = hrp and hrp.Position or safePos
    end

    -- ===== aksi ambil / buka =====
    local function firePrompt(pp)
        pcall(function() pp.HoldDuration = 0 end)
        pcall(function() pp.RequiresLineOfSight = false end)
        pcall(function() pp.MaxActivationDistance = math.max(pp.MaxActivationDistance, 30) end)
        if fireproximityprompt then
            pcall(fireproximityprompt, pp)
        else
            pcall(function()
                pp:InputHoldBegin()
                task.wait(0.1)
                pp:InputHoldEnd()
            end)
        end
    end

    local function fireNearby(radius)
        local r = nearby(radius)
        local n = 0
        for _, e in ipairs(r.prompts) do
            if e.inst.Enabled then
                firePrompt(e.inst)
                n = n + 1
            end
        end
        if fireclickdetector then
            for _, e in ipairs(r.clicks) do
                pcall(fireclickdetector, e.inst)
                n = n + 1
            end
        end
        return n
    end

    local function keyToolCount()
        local n = 0
        local bp = player:FindFirstChildOfClass("Backpack")
        local c = player.Character
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and isKeyName(t.Name:lower()) then n = n + 1 end
            end
        end
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and isKeyName(t.Name:lower()) then n = n + 1 end
            end
        end
        return n
    end

    local function useKeyTools()
        local bp = player:FindFirstChildOfClass("Backpack")
        local hum = getHum()
        if not bp or not hum then return end
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and isKeyName(t.Name:lower()) then
                pcall(function() hum:EquipTool(t) end)
                task.wait(0.15)
                pcall(function() t:Activate() end)
                task.wait(0.15)
            end
        end
    end

    local function trigger(obj, part, radius)
        local hrp = getHrp()

        local pp = obj:IsA("ProximityPrompt") and obj or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pp then firePrompt(pp) end

        local cd = obj:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then pcall(fireclickdetector, cd) end

        if firetouchinterest and hrp and part then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                task.wait(0.05)
                firetouchinterest(hrp, part, 1)
            end)
        end

        fireNearby(radius)
    end

    -- kunci dianggap terambil kalau hilang dari map, ada di tas / tangan, atau jumlah kunci di tas nambah
    local function collected(k, before)
        if not k.obj:IsDescendantOf(Workspace) then return true end
        if mine(k.obj) then return true end
        return keyToolCount() > before
    end

    local function collectKeys(my)
        waitIndex()
        local got, total = 0, 0
        local seen, tries = {}, {}
        for round = 1, 3 do
            local list = {}
            for _, k in ipairs(topKeys()) do
                if (tries[k.obj] or 0) < 2 then table.insert(list, k) end
            end
            if #list == 0 then break end

            for i, k in ipairs(list) do
                if session ~= my or not gui.Parent then return got, total end
                guard(my)
                if session ~= my then return got, total end

                if not seen[k.obj] then
                    seen[k.obj] = true
                    total = total + 1
                end
                tries[k.obj] = (tries[k.obj] or 0) + 1

                setStatus("ambil kunci " .. i .. "/" .. #list .. " (putaran " .. round .. ")")
                local before = keyToolCount()
                tp(k.part.Position, 3)
                task.wait(0.25)
                trigger(k.obj, k.part, KEY_RADIUS)
                task.wait(STEP_DELAY)

                if not collected(k, before) then
                    -- injak langsung kuncinya (buat yang diambil lewat sentuhan)
                    tp(k.part.Position, 0.5)
                    task.wait(0.2)
                    trigger(k.obj, k.part, KEY_RADIUS)
                    task.wait(0.4)
                end

                if collected(k, before) then got = got + 1 end
            end
            task.wait(0.4)
        end
        return got, total
    end

    local function doExit(my)
        if session ~= my then return false end
        waitIndex()
        setStatus("cari pintu keluar...")
        local obj, part = findExit()
        if not obj or not part then
            setStatus("pintu keluar tidak ketemu. Pakai COPY INFO SEKITAR di dekat pintu")
            return false
        end
        useKeyTools()
        for try = 1, 3 do
            if session ~= my then return false end
            guard(my)
            if session ~= my then return false end
            setStatus("buka pintu keluar (percobaan " .. try .. "/3)")
            tp(part.Position, 3)
            task.wait(0.3)
            trigger(obj, part, DOOR_RADIUS)
            task.wait(0.6)
            useKeyTools()
        end
        setStatus("sudah coba buka pintu keluar, cek hasilnya")
        return true
    end

